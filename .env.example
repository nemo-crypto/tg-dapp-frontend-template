# Copy this file to .env.local and fill in the values for your deployment.
# NEXT_PUBLIC_* variables are available to browser code.

# Backend endpoint used by the Next.js API proxy.
NEXT_PUBLIC_API_URL=

# Values expected by the client-side request helpers and your backend.
# AES keys are read as hexadecimal by the encrypt helper.
NEXT_PUBLIC_AES_KEY=
NEXT_PUBLIC_SIG_KEY=

# Telegram Mini App link and text used by referral sharing.
NEXT_PUBLIC_TMA_URL=
NEXT_PUBLIC_SHARE_MSG=
